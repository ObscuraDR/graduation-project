# ─── Environment ────────────────────────────────────────────────────────────
# development  → warnings only, localhost CORS defaults
# production   → strict validation; startup fails on weak keys or missing CORS
ENVIRONMENT=development

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ids_db
POSTGRES_USER=ids_user
POSTGRES_PASSWORD=ids_password

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=ids_logs
# URI-style override (takes priority over host/port fields when set)
# Docker: mongodb://ids_mongo_user:ids_mongo_pass@localhost:27017/ids_logs?authSource=admin
MONGO_URI=
MONGO_DB=ids_logs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# URI-style override (takes priority over host/port fields when set)
# Docker: redis://:ids_redis_pass@localhost:6379/0
REDIS_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_KEY=changeme-set-API_KEY-in-env

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS origins (comma-separated)
# development: defaults to http://localhost:3000,http://127.0.0.1:3000 (no need to set)
# production:  REQUIRED — wildcard "*" is forbidden
#              Example: CORS_ORIGINS=https://ids.example.com,https://dashboard.example.com
CORS_ORIGINS=

# ─── Production checklist ────────────────────────────────────────────────────
# 1. Set ENVIRONMENT=production
# 2. Set SECRET_KEY to a random string >= 32 chars  (e.g. openssl rand -hex 32)
# 3. Set API_KEY to a random string >= 16 chars     (e.g. openssl rand -hex 16)
# 4. Set CORS_ORIGINS to your real frontend URL(s)
# 5. Run: python backend/scripts/verify_config_security.py
# ─────────────────────────────────────────────────────────────────────────────

# Request size limit in bytes (default: 10MB)
MAX_REQUEST_SIZE=10485760

# Live-attack replay demo (thesis defense only)
# When true, /api/demo/start can stream curated CICIDS2017 attack flows through
# the real ML + alert pipeline to produce real-time WebSocket alerts.
# Keep false in any non-demo deployment.
ENABLE_DEMO_REPLAY=false

# Email Alerts
# Set ENABLE_EMAIL_ALERTS=true to send emails for high/critical alerts
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=IDS System <noreply@ids-system.com>
# Comma-separated list of SOC recipients
SMTP_TO=soc-lead@example.com,analyst@example.com
# Minimum seconds between emails per attacker IP (anti-spam)
EMAIL_COOLDOWN_SECONDS=60

# Alert Thresholds
ALERT_THRESHOLD_CRITICAL=0.9
ALERT_THRESHOLD_HIGH=0.7
ALERT_THRESHOLD_MEDIUM=0.5

# Model Paths
MODEL_DIR=./backend/models
RF_MODEL_PATH=./backend/models/random_forest.pkl
XGB_MODEL_PATH=./backend/models/xgboost.pkl
LSTM_MODEL_PATH=./backend/models/lstm.h5
ENSEMBLE_MODEL_PATH=./backend/models/ensemble.pkl

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log
